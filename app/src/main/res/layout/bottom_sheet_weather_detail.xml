<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheetDetail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@color/surface"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <!-- Header Row: Place Name & Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnCloseSheet"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailPlaceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Vilnius" />

                <TextView
                    android:id="@+id/tvDetailDivision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    tools:text="Vilniaus miesto savivaldybė" />

                <TextView
                    android:id="@+id/tvDetailCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Coordinates: 54.6872° N, 25.2797° E" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/on_surface_variant" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <!-- Loading View for on-demand fetch -->
        <LinearLayout
            android:id="@+id/layoutDetailLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvDetailLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_loading_forecast"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Weather Info Content -->
        <LinearLayout
            android:id="@+id/layoutDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Temperature & Condition Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvDetailTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_dark"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="18.5°C" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Clear Sky" />

                    <TextView
                        android:id="@+id/tvDetailFeelsLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        tools:text="Feels like: 18.0°C" />
                </LinearLayout>
            </LinearLayout>

            <!-- Metrics Grid / Details -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:layout_marginBottom="12dp">

                <!-- Wind Speed -->
                <TextView
                    android:id="@+id/tvDetailWind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    tools:text="Wind: 4.2 m/s" />

                <!-- Humidity -->
                <TextView
                    android:id="@+id/tvDetailHumidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    tools:text="Humidity: 65%" />

                <!-- Precipitation -->
                <TextView
                    android:id="@+id/tvDetailPrecipitation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    tools:text="Precipitation: 0.0 mm" />

                <!-- Pressure -->
                <TextView
                    android:id="@+id/tvDetailPressure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    tools:text="Pressure: 1018 hPa" />

                <!-- Cloud Cover -->
                <TextView
                    android:id="@+id/tvDetailCloudCover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    tools:text="Cloud Cover: 15%" />

                <!-- Update Time -->
                <TextView
                    android:id="@+id/tvDetailForecastTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Valid: 2026-11-17 17:00" />
            </GridLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
