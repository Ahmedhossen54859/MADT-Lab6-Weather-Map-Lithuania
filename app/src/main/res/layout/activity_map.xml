<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar & Progress -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarMap"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="@string/title_activity_map"
            app:titleTextColor="#FFFFFF" />

        <!-- Linear Progress for initial places loading & background sync -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSync"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/primary_dark"
            tools:visibility="visible" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Map & Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Google Map Fragment -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Floating Search & Filter Control Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFilterControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Search View for City/Location Name -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchViewPlaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:iconifiedByDefault="false"
                    app:queryHint="@string/hint_search_places" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider" />

                <!-- Bottom Filter Row: Spinner + Count Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/spinnerConditionFilter"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:id="@+id/tvLocationsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        tools:text="Showing 103 locations" />
                </LinearLayout>

                <!-- Sync status subtitle -->
                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/secondary_dark"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Syncing weather data: 12/103..." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Weather Detail Bottom Sheet -->
    <include
        android:id="@+id/includedBottomSheet"
        layout="@layout/bottom_sheet_weather_detail" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
